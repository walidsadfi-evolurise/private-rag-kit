# Copy to .env — every variable is optional, defaults run offline with the hash embedder + fake LLM.

# Store: memory://<path-without-suffix> or postgresql://user:pass@host:5432/db
RAG_STORE_URL=memory://./data/index

# Embeddings: hash | ollama | openai
RAG_EMBED_PROVIDER=hash
RAG_EMBED_MODEL=nomic-embed-text
# RAG_EMBED_BASE_URL=http://localhost:11434

# Generation: fake | ollama | anthropic | openai
RAG_LLM_PROVIDER=fake
RAG_LLM_MODEL=llama3.1:8b
# RAG_LLM_BASE_URL=http://localhost:11434
# RAG_ANTHROPIC_API_KEY=
# RAG_OPENAI_API_KEY=

RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150

# If set, the HTTP API requires `Authorization: Bearer <token>`
RAG_API_TOKEN=change-me
